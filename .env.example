PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Required only when using the future-use storage service.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=handwritten-files

MAX_IMAGE_COUNT=5
MAX_IMAGE_SIZE_BYTES=10485760

JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_BASE_URL=https://api.jina.ai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.2
YOLO_MODEL_PATH=models/best.pt
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=handwritten_pages
JINA_QDRANT_COLLECTION=handwritten_pages_jina
DOCUMENT_STORAGE_DIR=data/documents
